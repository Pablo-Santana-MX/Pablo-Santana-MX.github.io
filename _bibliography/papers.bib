@article{10.7717/peerj.11527,
 title = {Nacre morphology and chemical composition in Atlantic winged oyster \textit{Pteria colymbus} (Röding, 1798)},
 author = {Santana, Pablo and Aldana Aranda, Dalila},
 year = 2021,
 month = jul,
 keywords = {Nacre, Microstructure, Nanocrystals, Oyster, Chemical composition, Pteria},
 abstract = {The microstructure and nanostructure of nacre in \textit{Pteria colymbus} were studied with high-resolution field emission scanning electron microscopy (FESEM). The tablets were found to be flat and polyhedral with four to eight sides, and lengths ranging from 0.6 to 3.0 µm. They consisted of nanocrystals 41 nm wide, growing in the same direction. X-ray diffraction showed the crystals to be mineral phase aragonite, which was confirmed by Raman spectroscopy. Fourier transform infrared spectroscopy identified a band at 1,786.95 cm\textsuperscript{−1} attributed to carboxylate (carbonyl) groups of the proteins present in the organic matrix as well as bands characteristic of calcium carbonate. X-ray fluorescence showed the nacre to contain 98% calcium carbonate, as well as minor elements (Si, Na, S and Sr) and trace elements (Mg, P, Cu, Al, Fe, Cl, K and Zn).},
 volume = 9,
 pages = {e11527},
 journal = {PeerJ},
 issn = {2167-8359},
 url = {https://doi.org/10.7717/peerj.11527},
 doi = {10.7717/peerj.11527},
 abbr = {PeerJ},
 html = {https://peerj.com/articles/11527/},
 selected = {true}
}
